<?xml version="1.0" encoding="utf-8"?>
<!--
 Launcher foreground for this SSH-only fork.
 A terminal prompt chevron with "ssh" written where Termux puts the cursor line.

 Text is drawn as letter strokes rather than a font because vector drawables cannot
 reference a typeface. Keep the geometry in sync with the legacy mipmap PNGs
 (setup/render-legacy-icons.py).
-->
